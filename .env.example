PORT=3001
HOST=127.0.0.1
# 默认服务商：gemini 或 deepseek。界面保存的新设置优先于此默认值。
AI_PROVIDER=deepseek

# Gemini：填写你原来的 Chat Completions 兼容接口和密钥。
GEMINI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek：密钥只留在服务端，不使用 VITE_ 前缀。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 可选：后端出站 HTTP(S) 代理。默认直连；启用时使用 Node.js 26 或更新版本。
# macOS 系统代理不会自动被 Node fetch 使用，例如 http://127.0.0.1:7890。
# 仅填写你本机实际运行的代理地址。本机回环接口始终直连。
AI_PROXY_URL=

# 旧版 AI_BASE_URL / AI_API_KEY / AI_MODEL 仍兼容：
# 未定义 GEMINI_BASE_URL 和 GEMINI_API_KEY 时，作为 Gemini 分组使用。
# 当前统一模型设置不读取 AI_VISION_MODEL。
