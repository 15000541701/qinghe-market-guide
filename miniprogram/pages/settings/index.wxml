<view class="page"><view class="title">连接门店</view><view class="panel"><view class="panel-head">门店服务器</view><view class="panel-body"><view class="field"><label class="label" for="server-address">服务器地址</label><input id="server-address" value="{{base}}" bindinput="input" placeholder="http://电脑局域网IP:3001" placeholder-class="placeholder" maxlength="180"/></view><view class="note address-note">手机与电脑需连接同一网络</view><view class="actions"><button bindtap="scan" disabled="{{busy}}">扫码填写</button><button class="primary" bindtap="connect" loading="{{busy}}" disabled="{{busy}}">保存并连接</button></view><view class="status">{{connected ? '门店已连接' : '门店未连接'}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view></view><view class="panel"><view class="panel-head">快捷入口</view><view class="panel-body"><view class="actions"><button bindtap="guide">返回导购</button><button bindtap="store">进入超市端</button></view><button class="text-button clear-button" bindtap="clear">清空本机购物清单</button></view></view></view>
