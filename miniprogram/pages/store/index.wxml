<view class="page"><view class="title">商品上架与定价</view><view class="panel"><view class="row panel-head"><text>{{editingId ? '编辑商品' : '录入新商品'}}</text><button class="text-button" bindtap="reset" disabled="{{saving || recognizing}}">{{editingId ? '录入新商品' : '清空'}}</button></view><view class="panel-body"><button class="upload" bindtap="photo" disabled="{{recognizing || saving}}"><image wx:if="{{photo}}" src="{{photo}}" mode="aspectFit"/><view>{{recognizing ? '正在识别商品与分区…' : '拍照或选择商品图片'}}</view><view class="note">JPG / PNG / WebP · 最大 6MB</view></button><view class="candidates"><button wx:for="{{candidates}}" wx:key="name" class="small" bindtap="candidate" data-index="{{index}}">{{item.name}} · {{item.categoryName}}</button></view><view class="field"><label class="label" for="product-name">商品名称</label><input id="product-name" value="{{form.name}}" data-field="name" bindinput="field" maxlength="60" placeholder="例如：新鲜菠菜" placeholder-class="placeholder"/></view><view class="form-grid"><view class="field"><view class="label">商品分区</view><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="picker">{{categories[categoryIndex].name}}</view></picker></view><view class="field"><label class="label" for="shelf">货架编号</label><input id="shelf" value="{{form.shelf}}" data-field="shelf" bindinput="field" maxlength="20"/></view><view class="field"><label class="label" for="unit">计价单位</label><input id="unit" value="{{form.unit}}" data-field="unit" bindinput="field" maxlength="20"/></view><view class="field"><label class="label" for="stock">库存数量</label><input id="stock" type="number" value="{{form.stock}}" data-field="stock" bindinput="field"/></view></view></view></view>
<view class="panel"><view class="panel-head">价格建议</view><view class="panel-body"><view class="field"><view class="label">参考同商品历史</view><picker range="{{baselines}}" value="{{baselineIndex}}" bindchange="baseline"><view class="picker">{{baselines[baselineIndex]}}</view></picker></view><block wx:if="{{!usd}}"><view class="section-title row"><text>新发地批发行情</text><button class="text-button" bindtap="copySource">复制来源</button></view><view class="field"><label class="label" for="market-query">行情商品名</label><input id="market-query" value="{{marketQuery}}" bindinput="marketInput" maxlength="40" placeholder="菠菜、鲈鱼等通用品名" placeholder-class="placeholder"/></view><view class="actions"><button bindtap="lookup" loading="{{marketBusy}}" disabled="{{marketBusy || !marketQuery}}">查询新发地行情</button></view><view wx:if="{{marketError}}" class="error">{{marketError}}</view><view wx:if="{{marketResult}}" class="market-results"><view class="note">{{marketResult.latestDate || '暂无报价'}} · {{quotes.length}} 条</view><radio-group bindchange="selectQuote"><label wx:for="{{quotes}}" wx:key="id" class="quote row {{selectedId === item.id ? 'selected' : ''}}"><radio value="{{item.id}}" checked="{{selectedId === item.id}}" disabled="{{item.unavailable}}" color="#315443"/><view class="grow"><view class="item-name">{{item.name}}</view><view class="note">产地 {{item.origin || '未注明'}} · {{item.spec || '规格未注明'}}</view><view class="note">¥{{item.lowText}}–{{item.highText}}/{{item.unit}}</view><view wx:if="{{item.warning}}" class="quote-warning">{{item.warning}}</view></view><view class="quote-price"><view>¥{{item.averageText}}</view><view class="note">/{{item.unit}}</view><view wx:if="{{item.converted}}" class="note">折合 ¥{{item.converted}}/{{form.unit}}</view></view></label></radio-group><view wx:if="{{selectedId}}" class="field"><label class="label" for="markup">试算加价率（%）</label><input id="markup" value="{{markup}}" type="digit" bindinput="markup"/><view class="retail">加价后的零售参考：{{retail ? '¥'+retail+'/'+form.unit : '请填写有效加价率'}}</view><button class="primary small" bindtap="applyQuote" disabled="{{!retail}}">用所选报价计算建议</button></view></view><view wx:if="{{applied}}" class="applied">{{applied}}</view>
<view class="advice"><view class="row"><view class="grow"><view class="note">建议售价</view><view wx:if="{{pricing}}">正在计算…</view><view wx:elif="{{advice && advice.price > 0}}" class="price">¥{{advice.priceText}}<text class="note">/{{form.unit}}</text></view><view wx:else class="item-name">待补充价格依据</view></view><button class="primary small" bindtap="adopt" disabled="{{pricing || !advice || !advice.price}}">采纳建议</button></view><view wx:if="{{advice}}" class="note">{{advice.explanation}}</view><view wx:if="{{advice && advice.price > 0}}" class="note">区间 ¥{{advice.lowText}}–{{advice.highText}}</view></view><view wx:if="{{advice}}" class="evidence"><view class="note">历史中位数：{{advice.historyText}} · {{advice.sampleCount}} 条记录</view><view class="note">{{advice.marketKind === 'wholesale' ? '批发加价后的零售参考' : '市场参考'}}：{{advice.marketText}}</view><view class="note">{{advice.marketSource || '无有效行情参考'}} {{advice.marketDate || ''}}</view></view>
<view class="section-title">手动补充零售参考价</view><view class="form-grid"><view class="field"><label class="label" for="manual-price">参考价（元 / {{form.unit}}）</label><input id="manual-price" value="{{manualPrice}}" type="digit" bindinput="manual" data-field="manualPrice"/></view><view class="field"><view class="label">参考日期</view><picker mode="date" value="{{manualDate}}" end="{{today}}" bindchange="date"><view class="picker">{{manualDate}}</view></picker></view></view><view class="field"><label class="label" for="manual-source">来源</label><input id="manual-source" value="{{manualSource}}" bindinput="manual" data-field="manualSource" maxlength="100" placeholder="供应商或零售参考来源" placeholder-class="placeholder"/></view><button class="text-button" bindtap="applyManual">使用手动参考价</button></block><view wx:if="{{usd}}" class="note">美元商品按来源报价定价{{sourcePrice ? '（当前 ' + sourcePrice + '）' : ''}}。新发地行情是人民币批发价，不用于美元商品，也不计算建议价。</view><view class="divider"></view><view class="field"><label class="label" for="final-price">最终售价（{{usd ? 'US$' : '元'}} / {{form.unit}}）</label><input id="final-price" value="{{form.price}}" type="digit" bindinput="field" data-field="price" placeholder="填写或采纳建议" placeholder-class="placeholder"/></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="actions"><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || recognizing}}">{{editingId ? '保存商品修改' : '确认并上架'}}</button></view></view></view>
<view class="section-title">门店商品 · {{inventoryTotal}} 件</view><input value="{{search}}" bindinput="search" placeholder="搜索商品或货架" placeholder-class="placeholder"/><view wx:for="{{inventory}}" wx:key="id" class="row item-line"><image class="thumb" src="{{item.imageUrl}}" mode="aspectFill" lazy-load/><view class="grow"><view class="item-name">{{item.name}}</view><view class="note">{{item.categoryName}} · {{item.shelf}}</view><view class="note">{{item.priceSymbol}}{{item.priceText}}/{{item.unit}} · 库存 {{item.stock}}</view></view><button class="small" bindtap="edit" data-id="{{item.id}}" disabled="{{saving || recognizing}}">编辑</button></view><view wx:if="{{hasMoreInventory}}" class="actions"><button class="secondary" bindtap="moreInventory">加载更多（已显示 {{inventory.length}} / {{inventoryTotal}}）</button></view></view>
