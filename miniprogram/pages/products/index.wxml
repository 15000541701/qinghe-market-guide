<view class="page"><view class="title">逛逛新鲜好物</view><view class="subtitle">按分区挑选，直接找到货架。</view><input class="search" placeholder="搜索商品名称" placeholder-class="placeholder" value="{{query}}" bindinput="search"/><scroll-view scroll-x class="categories"><button wx:for="{{categories}}" wx:key="id" class="category {{category === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="category">{{item.name}}</button></scroll-view><view class="row sorting"><text class="note">{{items.length}} 件在售商品</text><picker range="{{sorts}}" value="{{sort}}" bindchange="sort"><view class="sort-control">{{sorts[sort]}}</view></picker></view><view wx:if="{{error}}" class="error">{{error}}<button class="text-button" bindtap="settings">连接设置</button></view><view wx:if="{{loading}}" class="loading">正在加载商品…</view><view class="grid"><view wx:for="{{items}}" wx:key="id" class="product"><image class="photo" src="{{item.imageUrl}}" mode="aspectFill" lazy-load/><view class="location">{{item.categoryName}} · {{item.shelf}}</view><view class="item-name">{{item.name}}</view><view class="description">{{item.description}}</view><view class="price">¥{{item.priceText}}<text class="unit">/{{item.unit}}</text></view><view class="row tools"><button class="text-button" data-id="{{item.id}}" bindtap="go">带我去</button><button class="small {{item.added ? 'primary' : ''}}" data-id="{{item.id}}" bindtap="add" disabled="{{busy}}">{{item.added ? '再加一份' : '加入清单'}}</button></view></view></view><view wx:if="{{!items.length && !loading && !error}}" class="empty">没有符合条件的商品，试试其他分区或关键词。</view><view class="footer-note">初始商品为演示数据 · 图片仅供展示</view></view>
